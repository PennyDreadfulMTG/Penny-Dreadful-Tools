# Set up mysql container
mysql_passwd=bad-password

# Host ports for docker dev services (change these if you have conflicts on your machine)
DECKSITE_HOST_PORT=80
LOGSITE_HOST_PORT=5001
DB_HOST_PORT=3306
ADMINER_HOST_PORT=8080
REDIS_HOST_PORT=6379

# Download a copy of the db for testing against real data.  Turn this off if you want speed.
PDM_DOWNLOAD_DEVDB=true

# Discord config
oauth2_client_id=000000000000000000
oauth2_client_secret=xxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx
token=xxxxxxxxxxxxxxxxxxxxxxxx.xxxxxx.xxxxxxxxxxxxxx_xxxxxxxxxxxx
