{{#show_archetype_tree}}
    <section>
        <h2>Archetype Tree</h2>
        {{> archetypetree}}
    </section>
{{/show_archetype_tree}}
<section>
    <h2>Decks</h2>
    {{> livedecktable}}
</section>
<section>
    <h2>Cards</h2>
    {{> livecardtable}}
</section>
{{#history_chart}}
    <section class="history-chart">
        <h2>Meta Share By Season</h2>
        <canvas class="chart" data-type="{{type}}" data-labels="{{labels}}" data-series="{{series}}" data-options="{{options}}"></canvas>
    </section>
{{/history_chart}}
{{#show_top_players}}
    <section>
        <h2>Top Players</h2>
        <table>
            <thead>
                <tr>
                    <th>Player</th>
                    <th class="n">Decks</th>
                    <th class="n">Record</th>
                    <th class="n">Win %</th>
                </tr>
            </thead>
            <tbody>
                {{#people}}
                    <tr>
                        <td><a href="{{url}}">{{name}}</a></td>
                        <td class="n">{{num_decks}}</td>
                        <td class="n">{{#show_record}}{{wins}}–{{losses}}{{#draws}}–{{draws}}{{/draws}}{{/show_record}}</td>
                        <td class="n">{{win_percent}}</td>
                    </tr>
                {{/people}}
            </tbody>
        </table>
    </section>
{{/show_top_players}}
{{#show_record}}
    <section>
        <h2>Matchups</h2>
        {{#matchups}}
            {{> archetypetree}}
        {{/matchups}}
    </section>
{{/show_record}}
