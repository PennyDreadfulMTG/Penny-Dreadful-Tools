<section class="card-image-block">
    <img src="{{img_url}}" alt="{{display_name}}" class="card-img {{card_img_class}}">
    {{#alternate_name}}
        <p class="alternate-printing-note {{card_img_class}}">Alternate printing of <a class="card" href="{{canonical_url}}">{{canonical_name}}</a>.</p>
    {{/alternate_name}}
    {{^alternate_name}}
        {{#card.has_alternate_printed_names}}
            <p class="alternate-printing-note {{card_img_class}}">Also printed as {{#card.alternate_printed_names}}{{separator}}<a href="{{url}}">{{name}}</a>{{/card.alternate_printed_names}}.</p>
        {{/card.has_alternate_printed_names}}
    {{/alternate_name}}
    {{#bugs}}
        <p class="bug-desc {{card_img_class}}"><b>{{classification}} bug</b> {{description}}</p>
    {{/bugs}}
</section>
{{#played_competitively}}
    {{> stats}}
{{/played_competitively}}
{{> legal}}
{{#show_top_players_by_decks}}
<section>
    <h2>Most Played By</h2>
    <table>
        <thead><tr><th>Player</th><th>Decks</th><th>Win %</th></tr></thead>
        <tbody>
            {{#top_players_by_decks}}
            <tr><td><a href="{{person_url}}" class="person">{{name}}</a></td><td>{{num_decks}}</td><td>{{win_percent}}</td></tr>
            {{/top_players_by_decks}}
        </tbody>
    </table>
</section>
{{/show_top_players_by_decks}}
{{#show_top_players_by_win}}
<section>
    <h2>Highest Win Rate</h2>
    <table>
        <thead><tr><th>Player</th><th>Win %</th><th>Decks</th></tr></thead>
        <tbody>
            {{#top_players_by_win}}
            <tr><td><a href="{{person_url}}" class="person">{{name}}</a></td><td>{{win_percent}}</td><td>{{num_decks}}</td></tr>
            {{/top_players_by_win}}
        </tbody>
    </table>
</section>
{{/show_top_players_by_win}}
<section>
    <h2>Decks containing {{name}}</h2>
    {{> livedecktable}}
</section>
