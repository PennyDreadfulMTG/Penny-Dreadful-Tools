{{#deck_tables}}
    <section>
        <h2>{{title}}{{#subtitle}} <span class="subtitle">{{subtitle}}</span>{{/subtitle}}</h2>
        {{> decktable}}
        <p><a href="{{url}}">{{link_text}}</a></p>
    </section>
{{/deck_tables}}
{{#has_movers_and_shakers}}
    <section>
        <h2>{{_ Metagame}} <span class="subtitle">{{movers_and_shakers_window}}</span></h2>
        <table>
            <thead>
                <th>Archetype</th>
                <th class="n">Meta Share</th>
                <th class="n">Change</th>
                <th class="n">Record</th>
                <th class="n">Win %</th>
            </thead>
            <tbody>
                {{#archetypes}}
                    <tr data-href="{{url}}" class="clickable">
                        <td><a href="{{url}}">{{name}}</a></td>
                        <td class="n">{{meta_share_display}}</td>
                        <td class="n">{{meta_share_change_display}}</td>
                        <td class="n">{{wins}}–{{losses}}{{#draws}}–{{draws}}{{/draws}}</td>
                        <td class="n">{{win_percent}}</td>
                    </tr>
                {{/archetypes}}
            </tbody>
        </table>
        <p><a href="{{metagame_url}}">{{_ More metagame…}}</a></p>
    </section>
{{/has_movers_and_shakers}}
{{#has_top_cards}}
    <section>
        <h2>{{_ Top Cards}}</h2>
        <table>
            <thead>
                <th>Card</th>
                <th># Decks</th>
                <th>Win %</th>
            </thead>
            <tbody>
                {{#top_cards}}
                    <tr data-href="{{url}}" class="clickable">
                        <td>{{> singlecard}}</td>
                        <td class="n">{{num_decks_display}}</td>
                        <td class="n" title="Record: {{record_display}}" aria-label="{{win_percent_display}}%; record {{record_display}}">{{win_percent_display}}</td>
                    </tr>
                {{/top_cards}}
            </tbody>
        </table>
        <p><a href="{{cards_url}}">{{_ More cards…}}</a></p>
    </section>
{{/has_top_cards}}
<section>
    <h2>{{_ Tournaments}}</h2>
    {{> tournamentcalendar}}
    {{#kick_off_date}}
        <p><a href="{{kick_off_url}}">The Season {{season_id}} Kick Off</a> is on {{kick_off_date}}.</p>
    {{/kick_off_date}}
    {{#pd500_date}}
        <p><a href="{{pd500_url}}">The Penny Dreadful 500</a> is on {{pd500_date}}.</p>
    {{/pd500_date}}
</section>
{{#has_news}}
    {{> news}}
{{/has_news}}
<section class="rotation">
    <h2>Season {{season_id}}</h2>
    <p>Season {{season_id}} began {{season_start_display}} and ends {{season_end_display}}.</p>
    <ul>
        <li><a href="{{scryfall_url}}">{{_ Legal cards (scryfall)}}</a></li>
        <li><a href="{{legal_cards_url}}">{{_ Legal cards (text)}}</a></li>
    </ul>
    {{#in_rotation}}
        <p><a href="{{rotation_url}}">{{rotation_msg}}</a></p>
    {{/in_rotation}}
</section>
<section class="stats">
    <h2>{{_ Community Stats}}</h2>
    {{#community_stats}}
        <p>{{header}}</p>
        <ul>
            {{#stats}}
                <li>{{text}}</li>
            {{/stats}}
        </ul>
    {{/community_stats}}
</section>
