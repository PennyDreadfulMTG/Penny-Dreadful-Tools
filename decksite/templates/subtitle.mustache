{{#competition_season_name}}
    <div class="subtitle">
        <a href="{{competition_season_url}}">{{competition_season_name}}</a>{{#competition_dates}} · {{competition_dates}}{{/competition_dates}}
    </div>
{{/competition_season_name}}
{{^competition_season_name}}
    {{#competition_dates}}
        <div class="subtitle">
            {{competition_dates}}
        </div>
    {{/competition_dates}}
{{/competition_season_name}}
{{^competition_dates}}
    {{#competition_ends_friendly}}
        <div class="subtitle">
            Ends {{> friendlytime}}
        </div>
    {{/competition_ends_friendly}}
    {{^competition_ends_friendly}}
        {{#date}}
            <div class="subtitle">
                {{#friendly_date}}{{> friendlytime}}{{/friendly_date}}
            </div>
        {{/date}}
    {{/competition_ends_friendly}}
{{/competition_dates}}
{{#is_deck_page}}
    <div class="subtitle">
        {{#public}}{{#reviewed}}<a href="{{archetype_url}}">{{archetype_name}}</a>{{/reviewed}}{{/public}}
        {{#reviewed}}d{{/reviewed}}{{^reviewed}}D{{/reviewed}}eck
        by <a href="{{person_url}}" class="person">{{person}}</a>
    </div>
    <div class="subtitle">
        {{#friendly_date}}{{> friendlytime}}{{/friendly_date}}
    </div>
    <div class="subtitle">
        <a href="{{#competition_url}}{{competition_url}}{{/competition_url}}{{^competition_url}}{{source_url}}{{/competition_url}}">
            {{source_name}} {{> record}}
        </a>
        {{{active_safe}}}
    </div>
{{/is_deck_page}}
